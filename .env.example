# ==============================================================================
# PlacePrep Environment Configuration
# ==============================================================================
# This application is 100% self-contained and functions completely OFFLINE by default.
# No environment variables or API keys are required to run the demo locally.
# The keys below are optional hooks for connecting production databases & cloud AI models.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Optional: Cloud Database (PostgreSQL / Supabase / MongoDB)
# ------------------------------------------------------------------------------
# Leave blank for offline mode. When blank, PlacePrep runs on local browser storage & JSON mocks.
# DATABASE_URL=postgresql://user:password@localhost:5432/placeprep

# ------------------------------------------------------------------------------
# 3. Optional: Remote AI Services (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Leave blank for offline mode. When blank, PlacePrep uses its built-in local heuristic engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Optional: Authentication Secrets
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
